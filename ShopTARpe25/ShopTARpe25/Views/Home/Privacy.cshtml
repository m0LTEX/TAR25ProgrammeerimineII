@{
    ViewData["Title"] = "Privacy";
}

<div class="privacy-page">
    <div class="privacy-card">
        <div class="privacy-icon">♧</div>

        <span class="privacy-label">YOUR INFORMATION</span>

        <h1>Privacy Policy</h1>

        <p class="privacy-intro">
            Your privacy matters. Here you can learn how information
            is handled while using ShopTARpe25.
        </p>

        <div class="privacy-section">
            <h2>Information</h2>
            <p>
                This website helps you manage your spaceship collection.
                Information entered into the application may be stored
                in its database.
            </p>
        </div>

        <div class="privacy-section">
            <h2>Your data</h2>
            <p>
                Only enter information that is appropriate for this
                application. Avoid sharing passwords or other sensitive
                personal information.
            </p>
        </div>

        <div class="privacy-footer">
            <span>✦</span> ShopTARpe25
        </div>
    </div>
</div>
