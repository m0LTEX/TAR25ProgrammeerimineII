@{
    ViewData["Title"] = "Home";
}

<div class="home-page">
    <div class="home-content">
        <span class="home-label">WELCOME TO YOUR UNIVERSE</span>

        <h1>ShopTARpe25</h1>

        <p>
            Explore your spaceship collection,
            manage your fleet and discover new possibilities.
        </p>

        <a asp-controller="Spaceship"
               asp-action="Index"
               class="home-button">
            Explore Spaceships <span>→</span>
        </a>
    </div>

    <div class="home-decoration">
        <div class="home-orbit orbit-one"></div>
        <div class="home-orbit orbit-two"></div>
        <div class="home-planet">✦</div>
        <div class="home-small-star star-one">✧</div>
        <div class="home-small-star star-two">✦</div>
        <div class="home-small-star star-three">✧</div>
    </div>
</div>
