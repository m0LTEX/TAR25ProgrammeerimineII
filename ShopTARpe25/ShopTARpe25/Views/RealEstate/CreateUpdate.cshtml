@model ShopTARpe25.Models.RealEstate.RealEstateCreateUpdateViewModel

<h1>Create RealEstate</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create"
              asp-controller="RealEstate"
              method="post"
              enctype="multipart/form-data">

            <div class="form-group mb-3">
                <label asp-for="Area" class="control-label"></label>
                <input asp-for="Area" class="form-control" />
                <span asp-validation-for="Area" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address" class="control-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RoomNumber" class="control-label"></label>
                <input asp-for="RoomNumber" class="form-control" />
                <span asp-validation-for="RoomNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BuildingType" class="control-label"></label>
                <input asp-for="BuildingType" class="form-control" />
                <span asp-validation-for="BuildingType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create"
                       class="btn btn-primary btn-lg btn-outline-dark" />

                <a asp-action="Index"
                       asp-controller="RealEstate"
                       class="btn btn-primary btn-lg btn-outline-dark">
                    Back to list
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
