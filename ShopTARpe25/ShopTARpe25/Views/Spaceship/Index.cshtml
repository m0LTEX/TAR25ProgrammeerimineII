@model IEnumerable<ShopTARpe25.Models.Spaceship.SpaceshipIndexViewModel>

@{
    ViewData["Title"] = "Spaceship";
    int rowNumber = 1;
}

<div class="spaceship-page">

    <div class="spaceship-header">
        <div>
            <span class="spaceship-label">YOUR COLLECTION</span>
            <h1>Spaceship</h1>
            <p>Manage and explore your spaceships.</p>
        </div>

        <a asp-action="Create"
               asp-controller="Spaceship"
               class="spaceship-create">
            + Create spaceship
        </a>
    </div>

    <div class="spaceship-summary">
        <div class="summary-icon">✦</div>
        <div>
            <span>Total spaceships</span>
            <strong>@(Model?.Count() ?? 0)</strong>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="spaceship-empty">
            <div class="empty-icon">✧</div>
            <h2>No spaceships yet</h2>
            <p>Your collection is waiting for its first spaceship.</p>

            <a asp-action="Create"
                   asp-controller="Spaceship"
                   class="spaceship-create">
                Create your first spaceship
            </a>
        </div>
    }
    else
    {
        <div class="spaceship-grid">
            @foreach (var spaceship in Model)
            {
                <article class="spaceship-card">
                    <div class="card-top">
                        <div class="spaceship-icon">✦</div>
                        <span class="spaceship-number">
                            #@rowNumber.ToString("00")
                        </span>
                    </div>

                    <h2>@spaceship.Name</h2>
                    <p class="spaceship-type">
                        @spaceship.Classification
                    </p>

                    <div class="spaceship-info">
                        <div class="info-item">
                            <span>Built date</span>
                            <strong>
                                @(spaceship.BuiltDate.HasValue
                                    ? spaceship.BuiltDate.Value.ToString("dd.MM.yyyy")
                                    : "Not specified")
                            </strong>
                        </div>

                        <div class="info-item">
                            <span>Crew</span>
                            <strong>@spaceship.Crew</strong>
                        </div>
                    </div>

                    <div class="spaceship-actions">
                        <a asp-action="Details"
                               asp-controller="Spaceship"
                               asp-route-id="@spaceship.Id"
                               class="ship-btn details-btn">
                            Details
                        </a>

                        <a asp-action="Update"
                               asp-controller="Spaceship"
                               asp-route-id="@spaceship.Id"
                               class="ship-btn update-btn">
                            Update
                        </a>

                        <a asp-action="Delete"
                               asp-controller="Spaceship"
                               asp-route-id="@spaceship.Id"
                               class="ship-btn delete-btn">
                            Delete
                        </a>
                    </div>
                </article>

                rowNumber++;
            }
        </div>
    }

</div>
