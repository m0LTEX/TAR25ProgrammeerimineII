@model ShopTARpe25.Models.Spaceship.SpaceshipDeleteViewModel

<h1>Delete</h1>

<h3>Are you sure you want to delete this spaceship?</h3>

<div>
    <h4>Spaceship</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Classification</dt>
        <dd class="col-sm-10">@Model.Classification</dd>

        <dt class="col-sm-2">Built Date</dt>
        <dd class="col-sm-10">@Model.BuiltDate</dd>

        <dt class="col-sm-2">Crew</dt>
        <dd class="col-sm-10">@Model.Crew</dd>

        <dt class="col-sm-2">Engine Power</dt>
        <dd class="col-sm-10">@Model.EnginePower</dd>

        <dt class="col-sm-2">CreatedAt</dt>
        <dd class="col-sm-10">@Model.CreatedAt</dd>

        <dt class="col-sm-2">ModifiedAt</dt>
        <dd class="col-sm-10">@Model.ModifiedAt</dd>
    </dl>

    <form asp-action="DeleteConfirmation" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>

